{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // base tsconfig.json은 "types": ["vite/client"]만 잡아준다 — e2e 코드는
    // import.meta.env를 쓰지 않고, @playwright/test와 Buffer 등에 필요한 타입은
